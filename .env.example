# VeriRoute: Entailment-Verified Semantic LLM Gateway & LinUCB Bandit Router
# Copy this file to .env to customize settings

# Provider Mode: "simulator" (default zero-cost calibrated simulation) or "live" (uses real API keys below)
VERIROUTE_PROVIDER_MODE=simulator

# Optional Live Upstream API Keys (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Stage-1 & Stage-2 Semantic Cache Thresholds
CACHE_COSINE_THRESHOLD=0.82
CACHE_ENTAILMENT_THRESHOLD=0.70
CACHE_CONTRADICTION_CEILING=0.25

# LinUCB Contextual Bandit Hyperparameters
BANDIT_ALPHA=0.85
BANDIT_LATENCY_PENALTY=0.15
SHADOW_SAMPLE_RATE=0.15

# Rate Limiting (Token Bucket per Tenant)
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=2.0

# Optional ONNX NLI Cross-Encoder model directory (falls back to fast Neuro-Symbolic NLI Engine if unset)
ONNX_NLI_MODEL_PATH=
